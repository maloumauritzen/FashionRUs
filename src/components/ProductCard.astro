---
const { data } = Astro.props;
---

<section class="productList">
  <article class="smallProduct" product.soldout ? "sold-out_container">
    <img
      src=`https://kea-alt-del.dk/t7/images/webp/640/${data.id}.webp`
      alt="trøje"
    />
    <p>{data.productdisplayname}<br />DKK {data.price},-</p>
    {
      data.discount ? (
        <p class="discount">Normalpris: DKK {data.price},-</p>
      ) : (
        ""
      )
    }

    {data.solout ? '<span class="sold-out_tekst">Udsolgt</span>' : ""}

    <a class="read_more" href="product.html">Gå til produkt</a>
  </article>
</section>
